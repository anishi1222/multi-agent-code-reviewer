<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Sink-side secret masking (ADR-0007 D6).

        Masking is the responsibility of the *sink*, not of the objects being logged. An object that
        masks its own `toString()` only guards that one method: `get()`, `entrySet()`, a JSON
        serializer or a debugger all still see the raw value, and the guard is lost the moment the
        value is copied into a type we do not own. These two patterns run on every appender, so they
        hold regardless of which object — ours or a third party's — produced the text.

        MASK_PATTERN        masks by *value shape*: recognizable token formats, wherever they appear.
        HEADER_MASK_PATTERN masks by *header name*: any `name=value` / `name: value` whose name looks
                            sensitive, whatever the value looks like. This is the branch that covers
                            opaque custom headers from `reviewer.mcp.github.headers`, which have no
                            recognizable prefix for MASK_PATTERN to catch.

        Order matters and is asserted by SensitiveHeaderMaskingSinkCanaryTest: MASK_PATTERN must run
        *first* (innermost), because HEADER_MASK_PATTERN stops at whitespace and would otherwise
        consume only the `Bearer` keyword and leave the token behind.
    -->
    <property name="MASK_PATTERN" value="(?i)(Bearer\s+|token\s+|ghp_|gho_|ghs_|ghu_|ghr_|github_pat_|sk-|xox[baprs]-)[A-Za-z0-9._\-]+"/>
    <property name="HEADER_MASK_PATTERN" value="(?i)([\w-]*(?:authorization|api-?key|secret|password|credential|cookie|token)[\w-]*\s*[=:]\s*)[^,\s}\]&quot;]+"/>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} [exec:%X{execution.id}] [%X{event.category}:%X{event.action}] - %replace(%replace(%msg){'${MASK_PATTERN}','$1***'}){'${HEADER_MASK_PATTERN}','$1***'}%n</pattern>
        </encoder>
    </appender>

    <appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/security-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/security-audit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} level=%-5level execution.id=%X{execution.id} category=%X{event.category} action=%X{event.action} mdc=%X %replace(%replace(%msg){'${MASK_PATTERN}','$1***'}){'${HEADER_MASK_PATTERN}','$1***'}%n</pattern>
        </encoder>
    </appender>
    
    <!-- Application loggers -->
    <logger name="dev.logicojp.reviewer" level="INFO"/>

    <!--
        Third-party loggers: managed here in logback.xml rather than in
        Micronaut's application.yml because the CLI verbose flag toggles
        log levels at runtime via the Logback API directly
        (see ReviewApp.enableVerboseLogging).
    -->
    <logger name="com.github.copilot" level="WARN"/>
    <logger name="org.yaml.snakeyaml" level="WARN"/>
    <logger name="SECURITY_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
